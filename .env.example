# StyleSense AI configuration — copy to .env and fill in your own values.

# --- Grok (xAI) LLM ---------------------------------------------------------
XAI_API_KEY=your-real-xai-api-key
XAI_MODEL=grok-3-latest
XAI_API_URL=https://api.x.ai/v1/chat/completions

# --- Qdrant Cloud (RAG vector store) ----------------------------------------
# Leave these blank to run without RAG — the app falls back to Grok + local rules.
QDRANT_URL=https://YOUR-CLUSTER-ID.REGION.aws.cloud.qdrant.io:6333
QDRANT_API_KEY=your-qdrant-cloud-api-key
QDRANT_COLLECTION=stylesense_fashion

# --- Embeddings (local, via fastembed — no API cost) ------------------------
EMBED_MODEL=BAAI/bge-small-en-v1.5

# --- Knowledge sources ------------------------------------------------------
# Point RAG at your own Excel file (any rows-and-columns layout). Leave blank to
# use only the built-in knowledge_base.json. You can also pass it per-run:
#   python ingest.py --xlsx path/to/file.xlsx
# KB_XLSX=data/my_fashion_data.xlsx
# KB_XLSX_SHEET=Sheet1
# Set to 0 to use ONLY your Excel file and drop the built-in fashion entries.
KB_INCLUDE_BUILTIN=1

# --- Retrieval tuning -------------------------------------------------------
# Cosine similarity thresholds for the bge-small model (0..1). Tune to taste:
#   >= RAG_ANSWER_THRESHOLD   -> answer straight from the knowledge base (NO LLM call)
#   >= RAG_CONTEXT_THRESHOLD  -> still call Grok, but ground it with retrieved notes
RAG_ANSWER_THRESHOLD=0.85
RAG_CONTEXT_THRESHOLD=0.60

# Show a small "from knowledge base" marker on cached answers (1 = on, 0 = off)
STYLESENSE_SHOW_SOURCE=1
